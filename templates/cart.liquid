{% stylesheet %}
  .cart-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .cart-title {
    font-size: 2rem;
    font-weight: bold;
    color: {{ settings.text_color }};
    margin-bottom: 2rem;
  }

  .cart-container {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
  }

  .cart-items {
    background: white;
    border-radius: 8px;
    padding: 2rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .cart-item {
    display: grid;
    grid-template-columns: 100px 1fr auto;
    gap: 1.5rem;
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid {{ settings.border_color }};
    align-items: start;
  }

  .cart-item:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .cart-item-image {
    width: 100px;
    height: 100px;
    object-fit: cover;
    border-radius: 4px;
  }

  .cart-item-details {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cart-item-title {
    font-weight: bold;
    color: {{ settings.text_color }};
  }

  .cart-item-variant {
    font-size: 0.875rem;
    color: #666;
  }

  .cart-item-price {
    color: {{ settings.primary_color }};
    font-weight: bold;
  }

  .cart-item-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-end;
  }

  .quantity-selector {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .quantity-button {
    width: 30px;
    height: 30px;
    border: 1px solid {{ settings.border_color }};
    background: white;
    cursor: pointer;
    border-radius: 4px;
    font-size: 1rem;
  }

  .quantity-input {
    width: 50px;
    text-align: center;
    border: 1px solid {{ settings.border_color }};
    padding: 0.25rem;
    border-radius: 4px;
  }

  .remove-item {
    color: #999;
    cursor: pointer;
    font-size: 0.875rem;
    text-decoration: underline;
  }

  .cart-summary {
    background: white;
    border-radius: 8px;
    padding: 2rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    height: fit-content;
  }

  .summary-title {
    font-size: 1.25rem;
    font-weight: bold;
    color: {{ settings.text_color }};
    margin-bottom: 1.5rem;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 1rem;
    color: #666;
  }

  .summary-total {
    display: flex;
    justify-content: space-between;
    font-size: 1.25rem;
    font-weight: bold;
    color: {{ settings.primary_color }};
    padding-top: 1rem;
    border-top: 1px solid {{ settings.border_color }};
    margin-bottom: 1.5rem;
  }

  .free-shipping-bar {
    background: #f0fdf4;
    border: 1px solid #86efac;
    padding: 1rem;
    border-radius: 4px;
    margin-bottom: 1.5rem;
    text-align: center;
    color: #166534;
    font-size: 0.875rem;
  }

  .checkout-btn {
    width: 100%;
    background: {{ settings.primary_color }};
    color: white;
    padding: 1rem;
    border: none;
    border-radius: 4px;
    font-weight: bold;
    cursor: pointer;
    transition: background 0.3s;
    margin-bottom: 0.5rem;
  }

  .checkout-btn:hover {
    background: {{ settings.secondary_color }};
  }

  .continue-shopping-btn {
    width: 100%;
    background: white;
    color: {{ settings.primary_color }};
    padding: 1rem;
    border: 1px solid {{ settings.primary_color }};
    border-radius: 4px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.3s;
  }

  .continue-shopping-btn:hover {
    background: {{ settings.primary_color }};
    color: white;
  }

  .empty-cart {
    text-align: center;
    padding: 3rem;
    color: #999;
  }

  .empty-cart-title {
    font-size: 1.5rem;
    font-weight: bold;
    margin-bottom: 1rem;
  }

  .upsell-section {
    background: #f9fafb;
    border-radius: 8px;
    padding: 1.5rem;
    margin-top: 1.5rem;
  }

  .upsell-title {
    font-weight: bold;
    color: {{ settings.text_color }};
    margin-bottom: 1rem;
  }

  .upsell-products {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .upsell-item {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .upsell-item-image {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 4px;
  }

  .upsell-item-info {
    flex: 1;
  }

  .upsell-item-title {
    font-size: 0.875rem;
    font-weight: bold;
    color: {{ settings.text_color }};
  }

  .upsell-item-price {
    color: {{ settings.primary_color }};
    font-weight: bold;
  }

  .upsell-add-btn {
    padding: 0.25rem 0.75rem;
    background: {{ settings.primary_color }};
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.75rem;
  }

  @media (max-width: 768px) {
    .cart-container {
      grid-template-columns: 1fr;
    }

    .cart-item {
      grid-template-columns: 80px 1fr;
    }

    .cart-item-actions {
      grid-column: 1 / -1;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }

    .cart-item-image {
      width: 80px;
      height: 80px;
    }
  }
{% endstylesheet %}

<div class="cart-page">
  <h1 class="cart-title">{{ 'cart.title' | t }}</h1>

  {% if cart.item_count > 0 %}
    <div class="cart-container">
      <!-- Cart Items -->
      <div class="cart-items">
        {% for item in cart.items %}
          <div class="cart-item">
            <img src="{{ item.image | image_url: width: 100 }}" alt="{{ item.title }}" class="cart-item-image">
            
            <div class="cart-item-details">
              <a href="{{ item.url }}" class="cart-item-title">{{ item.title }}</a>
              {% if item.variant.title != 'Default Title' %}
                <p class="cart-item-variant">{{ item.variant.title }}</p>
              {% endif %}
              <p class="cart-item-price">{{ item.price | money }} each</p>
            </div>

            <div class="cart-item-actions">
              <div class="quantity-selector">
                <button class="quantity-button" onclick="updateQuantity({{ item.key }}, {{ item.quantity }} - 1)">−</button>
                <input type="number" class="quantity-input" value="{{ item.quantity }}" min="1" onchange="updateQuantity({{ item.key }}, this.value)">
                <button class="quantity-button" onclick="updateQuantity({{ item.key }}, {{ item.quantity }} + 1)">+</button>
              </div>
              <p style="color: {{ settings.primary_color }}; font-weight: bold;">{{ item.final_line_price | money }}</p>
              <a href="/cart/change?line={{ item.key }}&quantity=0" class="remove-item">Remove</a>
            </div>
          </div>
        {% endfor %}
      </div>

      <!-- Cart Summary -->
      <div class="cart-summary">
        <h2 class="summary-title">{{ 'cart.title' | t }}</h2>

        {% if settings.enable_free_shipping_bar %}
          {% assign free_shipping_threshold = settings.free_shipping_threshold | times: 100 %}
          {% if cart.total_price < free_shipping_threshold %}
            <div class="free-shipping-bar">
              {{ 'cart.free_shipping_message' | t: amount: free_shipping_threshold | money }}
            </div>
          {% else %}
            <div class="free-shipping-bar" style="background: #f0fdf4; border-color: #86efac; color: #166534;">
              ✓ You qualify for FREE SHIPPING!
            </div>
          {% endif %}
        {% endif %}

        <div class="summary-row">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>

        <div class="summary-row">
          <span>{{ 'cart.shipping' | t }}</span>
          <span>{{ 'Calculated at checkout' | t }}</span>
        </div>

        <div class="summary-row">
          <span>{{ 'cart.tax' | t }}</span>
          <span>{{ 'Calculated at checkout' | t }}</span>
        </div>

        <div class="summary-total">
          <span>{{ 'cart.total' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>

        <a href="/checkout" class="checkout-btn">{{ 'cart.checkout' | t }}</a>
        <a href="/collections/all" class="continue-shopping-btn">{{ 'cart.continue_shopping' | t }}</a>

        <!-- Upsell Section -->
        <div class="upsell-section">
          <p class="upsell-title">Recommended for you:</p>
          <div class="upsell-products">
            {% for product in collections.all.products limit: 3 %}
              <div class="upsell-item">
                <img src="{{ product.featured_image | image_url: width: 60 }}" alt="{{ product.title }}" class="upsell-item-image">
                <div class="upsell-item-info">
                  <p class="upsell-item-title">{{ product.title }}</p>
                  <p class="upsell-item-price">{{ product.price | money }}</p>
                </div>
                <form method="post" action="/cart/add" style="display: inline;">
                  <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                  <button type="submit" class="upsell-add-btn">Add</button>
                </form>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  {% else %}
    <div class="empty-cart">
      <p class="empty-cart-title">{{ 'cart.empty' | t }}</p>
      <p>{{ 'cart.continue_shopping' | t }}</p>
      <a href="/collections/all" class="continue-shopping-btn" style="display: inline-block; margin-top: 1rem; width: auto; padding: 0.75rem 1.5rem;">{{ 'cart.continue_shopping' | t }}</a>
    </div>
  {% endif %}
</div>

<script>
  function updateQuantity(lineKey, quantity) {
    if (quantity < 1) quantity = 0;
    window.location.href = `/cart/change?line=${lineKey}&quantity=${quantity}`;
  }
</script>
