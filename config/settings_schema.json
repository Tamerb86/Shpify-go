[
  {
    "name": "theme_info",
    "theme_name": "GoEasyCharge",
    "theme_store_id": null,
    "theme_author": "GoEasyCharge Team"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "primary_color",
        "label": "Primary Color",
        "default": "#2563eb"
      },
      {
        "type": "color",
        "id": "secondary_color",
        "label": "Secondary Color",
        "default": "#1e40af"
      },
      {
        "type": "color",
        "id": "accent_color",
        "label": "Accent Color",
        "default": "#10b981"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text Color",
        "default": "#1f2937"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading Font",
        "default": "sans-serif"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body Font",
        "default": "sans-serif"
      },
      {
        "type": "range",
        "id": "heading_size",
        "label": "Heading Size",
        "min": 24,
        "max": 48,
        "step": 2,
        "default": 36,
        "unit": "px"
      }
    ]
  },
  {
    "name": "Header",
    "settings": [
      {
        "type": "text",
        "id": "store_name",
        "label": "Store Name",
        "default": "GoEasyCharge"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo Width",
        "min": 50,
        "max": 200,
        "step": 10,
        "default": 120,
        "unit": "px"
      },
      {
        "type": "checkbox",
        "id": "show_search",
        "label": "Show Search",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_cart",
        "label": "Show Cart",
        "default": true
      }
    ]
  },
  {
    "name": "Hero Section",
    "settings": [
      {
        "type": "image_picker",
        "id": "hero_image",
        "label": "Hero Image"
      },
      {
        "type": "text",
        "id": "hero_title",
        "label": "Hero Title",
        "default": "Power Your Life Wirelessly"
      },
      {
        "type": "textarea",
        "id": "hero_subtitle",
        "label": "Hero Subtitle",
        "default": "Experience the future of charging with our premium wireless chargers"
      },
      {
        "type": "text",
        "id": "hero_cta_text",
        "label": "CTA Button Text",
        "default": "Shop Now"
      },
      {
        "type": "url",
        "id": "hero_cta_link",
        "label": "CTA Button Link"
      }
    ]
  },
  {
    "name": "Conversion Features",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_sticky_cart",
        "label": "Enable Sticky Add to Cart",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_quantity_bundles",
        "label": "Enable Quantity Bundles",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_urgency_blocks",
        "label": "Enable Urgency Blocks",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_free_shipping_bar",
        "label": "Enable Free Shipping Progress Bar",
        "default": true
      },
      {
        "type": "text",
        "id": "free_shipping_threshold",
        "label": "Free Shipping Threshold",
        "default": "100"
      }
    ]
  },
  {
    "name": "Newsletter",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_newsletter_popup",
        "label": "Enable Newsletter Popup",
        "default": true
      },
      {
        "type": "text",
        "id": "newsletter_discount",
        "label": "Newsletter Discount Code",
        "default": "WELCOME10"
      },
      {
        "type": "range",
        "id": "newsletter_discount_percent",
        "label": "Discount Percentage",
        "min": 5,
        "max": 50,
        "step": 5,
        "default": 10,
        "unit": "%"
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "url",
        "id": "instagram_url",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "tiktok_url",
        "label": "TikTok URL"
      },
      {
        "type": "url",
        "id": "facebook_url",
        "label": "Facebook URL"
      },
      {
        "type": "url",
        "id": "whatsapp_number",
        "label": "WhatsApp Number (e.g., +966501234567)"
      }
    ]
  },
  {
    "name": "Language",
    "settings": [
      {
        "type": "select",
        "id": "default_language",
        "label": "Default Language",
        "options": [
          {
            "value": "en",
            "label": "English"
          },
          {
            "value": "ar",
            "label": "العربية"
          }
        ],
        "default": "en"
      },
      {
        "type": "checkbox",
        "id": "enable_language_switcher",
        "label": "Enable Language Switcher",
        "default": true
      }
    ]
  }
]
