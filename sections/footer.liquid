            </svg>
          </a>
        {% endif %}
      </div>
    </div>

    <!-- Quick Links -->
    <div class="footer-section">
      <h3>{{ 'footer.about' | t }}</h3>
      <ul>
        <li><a href="/pages/about">{{ 'footer.about' | t }}</a></li>
        <li><a href="/pages/contact">{{ 'footer.contact' | t }}</a></li>
        <li><a href="/pages/faq">{{ 'footer.faq' | t }}</a></li>
        <li><a href="/pages/blog">{{ 'Blog' | t }}</a></li>
      </ul>
    </div>

    <!-- Policies -->
    <div class="footer-section">
      <h3>{{ 'Policies' | t }}</h3>
      <ul>
        <li><a href="/policies/privacy-policy">{{ 'footer.privacy' | t }}</a></li>
        <li><a href="/policies/terms-of-service">{{ 'footer.terms' | t }}</a></li>
        <li><a href="/policies/refund-policy">{{ 'footer.returns' | t }}</a></li>
        <li><a href="/policies/shipping-policy">{{ 'footer.shipping' | t }}</a></li>
      </ul>
    </div>

    <!-- Newsletter -->
    <div class="footer-section">
      <h3>{{ 'footer.newsletter' | t }}</h3>
      <form method="post" action="/contact" class="newsletter-form">
        <input type="email" name="contact[email]" placeholder="{{ 'footer.newsletter' | t }}" required>
        <button type="submit">{{ 'footer.newsletter' | t }}</button>
      </form>
    </div>
  </div>

  <!-- Payment Methods -->
  <div class="payment-methods">
    {% for payment_method in shop.enabled_payment_types %}
      <img src="{{ payment_method | payment_type_to_svg_url }}" alt="{{ payment_method }}" loading="lazy">
    {% endfor %}
  </div>

  <!-- Footer Bottom -->
  <div class="footer-bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'All rights reserved' | t }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
